{
  "name": "interview_framework",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "@wdio/cli": "^10.0.0",
    "@wdio/devtools-service": "^11.1.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "expect-webdriverio": "^8.0.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "webdriverio": "^10.0.0"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "test:e2e": "PATH=\"$(brew --prefix ffmpeg@7)/bin:$PATH\" wdio run ./wdio.conf.ts",
    "test:mobile": "PATH=\"$(brew --prefix ffmpeg@7)/bin:$PATH\" TEST_TARGET=mobile wdio run ./wdio.conf.ts",
    "test:mobile:mobile-s": "TEST_PROFILE=mobile-s npm run test:mobile",
    "test:mobile:mobile-m": "TEST_PROFILE=mobile-m npm run test:mobile",
    "test:mobile:mobile-l": "TEST_PROFILE=mobile-l npm run test:mobile",
    "test:mobile:tablet": "TEST_PROFILE=tablet npm run test:mobile",
    "test:mobile:foldable": "TEST_PROFILE=foldable npm run test:mobile",
    "test:mobile:all": "result=0; for profile in mobile-s mobile-m mobile-l tablet foldable; do TEST_PROFILE=\"$profile\" npm run test:mobile || result=1; done; exit \"$result\"",
    "test:mobile:login:all": "result=0; for profile in mobile-s mobile-m mobile-l tablet foldable; do echo \"Testing login on $profile\"; TEST_PROFILE=\"$profile\" npm run test:mobile -- --spec ./src/specs/loginPage.spec.ts || result=1; done; exit \"$result\"",
    "test:login": "npm run test:e2e -- --spec ./src/specs/loginPage.spec.ts",
    "test:cart": "npm run test:e2e -- --spec ./src/specs/cartPage.spec.ts",
    "test:store": "npm run test:e2e -- --spec ./src/specs/storePage.spec.ts",
    "test:checkout": "npm run test:e2e -- --spec ./src/specs/checkoutPage.spec.ts",
    "test:order-summary": "npm run test:e2e -- --spec ./src/specs/orderSummaryPage.spec.ts",
    "test:order-confirmation": "npm run test:e2e -- --spec ./src/specs/orderConfirmationPage.spec.ts"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3"
  }
}
